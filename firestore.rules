rules_version = '2';

// 가계부 데이터는 아래 두 Google 계정만 읽고 쓸 수 있다.
// 바꾼 뒤에는 Firebase 콘솔 > Firestore > 규칙 탭에 붙여넣고 '게시'해야 적용된다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'siw61001@gmail.com',
          'tiyddsx@gmail.com'
        ];
    }

    match /tx/{id} {
      allow read, write: if isMember();
    }
    match /assets/{id} {
      allow read, write: if isMember();
    }
    match /meta/{id} {
      allow read, write: if isMember();
    }
  }
}
